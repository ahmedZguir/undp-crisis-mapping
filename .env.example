# Copy to .env. A local trial works unchanged; before going live, run
# `python3 infra/gen_secrets.py` instead, which writes .env with real secrets.

# Site
SITE_URL=http://localhost:8080
HTTP_PORT=8080

# First admin, created on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Going live on a domain: Caddy gets the TLS certificate.
# SITE_URL=https://crisis.example.org
# SITE_ADDRESS=crisis.example.org
# HTTP_PORT=80
# HTTPS_PORT=443
# Native apps call cross-origin and must be admitted:
# CORS_ORIGIN_REGEX=^(https://crisis\.example\.org|capacitor://localhost|https?://localhost)$

# Optional features: fill in a group to turn it on.

# AI, any OpenAI-compatible server. Each feature turns on once its model is set.
# AI_BASE_URL=
# AI_API_KEY=
# AI_LLM_MODEL=
# AI_EMBEDDING_MODEL=
# AI_CLASSIFIER_MODEL=
# AI_TRANSCRIPTION_MODEL=
# AI_VISION_MODEL=
# AI_VISION_DISASTER_MODEL=

# WhatsApp (Meta Cloud API)
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_APP_SECRET=
# META_WHATSAPP_VERIFY_TOKEN=

# SMS (sms-gate.app Android gateway)
# SMS_GATEWAY_USERNAME=
# SMS_GATEWAY_PASSWORD=
# SMS_WEBHOOK_SECRET=

# Voice calls (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VOICE_NUMBER=

# Secrets. These are Supabase's public demo values: fine locally, never live.
