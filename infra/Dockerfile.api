# Shared image for the API (uvicorn) and the Arq worker; only CMD differs.
# Build from repo root: docker build -f infra/Dockerfile.api -t undp-api:dev .

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -sf /root/.local/bin/uv /usr/local/bin/uv

# Native libraries for WeasyPrint (report PDFs); without them even
# `import weasyprint` fails. GDK-PixBuf decodes the embedded PNG map tiles.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangocairo-1.0-0 libpangoft2-1.0-0 \
        libgdk-pixbuf-2.0-0 libcairo2 libffi8 libfontconfig1 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# pmtiles CLI slices per-crisis PMTiles out of Overture's global tile file.
# Pinned for reproducible builds.
ARG PMTILES_VERSION=1.22.2
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) pmtiles_arch=x86_64 ;; \
      arm64) pmtiles_arch=arm64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -LsSf -o /tmp/pmtiles.tar.gz \
      "https://github.com/protomaps/go-pmtiles/releases/download/v${PMTILES_VERSION}/go-pmtiles_${PMTILES_VERSION}_Linux_${pmtiles_arch}.tar.gz"; \
    tar -xzf /tmp/pmtiles.tar.gz -C /usr/local/bin pmtiles; \
    rm /tmp/pmtiles.tar.gz; \
    pmtiles version

WORKDIR /app

COPY apps/api/pyproject.toml apps/api/uv.lock /app/
# Vendored sdist for the captioning client (not on any index); uv sync needs it.
COPY apps/api/vendor /app/vendor
COPY apps/api/src /app/src

RUN uv sync --frozen

ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONPATH="/app/src"

# The worker service overrides CMD.
EXPOSE 8000
CMD ["uv", "run", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "src"]
