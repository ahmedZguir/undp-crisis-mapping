# Copy this to keystore.properties (gitignored) and fill in your values.
# Generate the keystore once on your Mac:
#
#   keytool -genkey -v -keystore ~/.android/undp-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias undp
#
storeFile=/Users/yourname/.android/undp-release.jks
storePassword=
keyAlias=undp
keyPassword=
